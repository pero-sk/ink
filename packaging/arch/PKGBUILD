# Maintainer: Beata C <beata.c@kittymail.com>

pkgname=ink
pkgver=0.1.5
pkgrel=1
pkgdesc="A small, terminal-based text editor"
arch=('x86_64')
url="https://github.com/pero-sk/ink"
license=('Apache-2.0')
depends=('glibc' 'libgcc')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::https://github.com/pero-sk/ink/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('772b0ccc0d23bd924ce4a5157320b67ed4af21b9c896b007d2b017fae072270a')

prepare() {
    cd "$srcdir/$pkgname-$pkgver"

    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked
}

build() {
    cd "$srcdir/$pkgname-$pkgver"

    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target

    cargo build --frozen --release --all-features
}

check() {
    cd "$srcdir/$pkgname-$pkgver"

    export RUSTUP_TOOLCHAIN=stable

    cargo test --frozen --all-features
}

package() {
    cd "$srcdir/$pkgname-$pkgver"

    install -Dm0755 "target/release/$pkgname" \
        "$pkgdir/usr/bin/$pkgname"

    install -Dm0644 "ink.1" \
        "$pkgdir/usr/share/man/man1/ink.1"

    install -Dm0644 "LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}